FROM node:22-bookworm-slim AS web
WORKDIR /src
COPY dxregia/web/package*.json ./
RUN npm ci
COPY dxregia/web/ .
RUN npm run build

FROM golang:1.24-bookworm AS backend
WORKDIR /src
COPY dxregia/backend/go.mod dxregia/backend/go.sum ./
RUN go mod download
COPY dxregia/backend/ .
RUN CGO_ENABLED=0 go build -trimpath -o /dxregia ./cmd/dxregia

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates perl git procps libev-perl libmojolicious-perl libjson-perl \
    libjson-xs-perl libdata-structure-util-perl libmath-round-perl libnet-cidr-lite-perl \
    libdbd-sqlite3-perl libdbi-perl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin dxregia \
    && install -d -o dxregia -g dxregia /data
COPY --from=backend /dxregia /usr/local/bin/dxregia
COPY --from=web /src/dist /opt/dxregia/web
COPY cmd /opt/mojo/cmd
COPY connect /opt/mojo/connect
COPY data /opt/mojo/data
COPY filter /opt/mojo/filter
COPY msg /opt/mojo/msg
COPY perl /opt/mojo/perl
COPY COPYING LICENSE /opt/mojo/
COPY dxregia/deploy/start-container.sh /usr/local/bin/dxregia-container
RUN chmod 0755 /usr/local/bin/dxregia-container
USER dxregia
VOLUME ["/data"]
EXPOSE 8080 7300
ENTRYPOINT ["/usr/local/bin/dxregia-container"]
