[Unit]
Description=DXRegia DX Cluster
After=network.target

[Service]
Type=simple
User=dxregia
Group=dxregia
StateDirectory=dxregia
StateDirectoryMode=0700
UMask=0077
Environment=DXREGIA_WEB_PORT=8080 DXREGIA_TELNET_PORT=7300 DXREGIA_HTTP_BIND=127.0.0.1 DXREGIA_TELNET_BIND=127.0.0.1
EnvironmentFile=-/etc/dxregia.env
ExecStart=/opt/dxregia/bin/dxregia -web /opt/dxregia/web -setup-root /var/lib/dxregia/mojo -setup-perl /usr/bin/perl -bootstrap-password-file /var/lib/dxregia/sysop-initial -http-bind ${DXREGIA_HTTP_BIND} -port ${DXREGIA_WEB_PORT} -telnet 127.0.0.1:${DXREGIA_TELNET_PORT} -setup-telnet-bind ${DXREGIA_TELNET_BIND}
Restart=on-failure
TimeoutStopSec=15s
KillMode=mixed
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
