[Unit]
Description=DXRegia DX Cluster
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
Type=simple
User=dxregia
Group=dxregia
StateDirectory=dxregia
StateDirectoryMode=0700
UMask=0077
Environment=DXREGIA_WEB_PORT=8080 DXREGIA_TELNET_PORT=7300 DXREGIA_HTTP_BIND=127.0.0.1
EnvironmentFile=-/etc/dxregia.env
ExecStart=/opt/dxregia/bin/dxregia -web /opt/dxregia/web -backup-tool /opt/dxregia/bin/dxregia-backup -setup-root /var/lib/dxregia/mojo -setup-perl /usr/bin/perl -bootstrap-password-file /var/lib/dxregia/sysop-initial -http-bind ${DXREGIA_HTTP_BIND} -port ${DXREGIA_WEB_PORT} -web-port-file /var/lib/dxregia/web-port -telnet 127.0.0.1:${DXREGIA_TELNET_PORT}
Restart=on-failure
TimeoutStopSec=15s
# Solo il processo web: il motore ha il suo gruppo e lo ferma il servizio stesso, salvo che un aggiornamento del
# solo pannello lasci il file keep-engine, nel qual caso resta attivo e il nuovo servizio lo adotta.
KillMode=process
# Rete di sicurezza: dopo un arresto pulito, senza keep-engine recente, il motore non deve restare acceso.
ExecStopPost=/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || exit 0; [ -z "$$(find /var/lib/dxregia/keep-engine -mmin -10 2>/dev/null)" ] || exit 0; p=$$(cat /var/lib/dxregia/mojo/local_data/dxregia-engine.pid 2>/dev/null); [ -n "$$p" ] && grep -q cluster.pl /proc/$$p/cmdline 2>/dev/null && kill $$p; exit 0'
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
